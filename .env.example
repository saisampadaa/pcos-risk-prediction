# Copy this file to .env and fill in your real key. .env is gitignored -
# never commit real secrets.

# Required for the AI explanation agent's live LLM path (src/agent.py), which
# calls Groq's API. Without this, the app automatically falls back to the
# deterministic rule-based explanation template - it still works, just
# without the LLM.
GROQ_API_KEY=gsk_your-key-here

# Optional: override which Groq-hosted model the agent uses (defaults to
# llama-3.3-70b-versatile if unset). See https://console.groq.com/docs/models
# for the current list.
# GROQ_AGENT_MODEL=llama-3.3-70b-versatile
